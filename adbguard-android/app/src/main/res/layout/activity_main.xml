<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 顶部标题 -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#16233A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="给爸妈手机装一个，专治流氓清理/弹窗应用"
            android:textColor="#6B7A93"
            android:textSize="13sp" />

        <!-- ============ 引导面板 ============ -->
        <LinearLayout
            android:id="@+id/panelGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/stepContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 等待无障碍的提示条 -->
            <TextView
                android:id="@+id/tvWaiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FFF4D6"
                android:padding="14dp"
                android:text="正在等待无障碍服务启动…"
                android:textColor="#8A6100"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnFinishGuide"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="#2F6FED"
                android:text="完成引导，进入守护面板"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ 主面板 ============ -->
        <LinearLayout
            android:id="@+id/panelMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 状态卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvShieldState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="守护状态：运行中"
                    android:textColor="#16233A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvA11yState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="无障碍：--"
                    android:textColor="#6B7A93"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvForeground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="当前前台：--"
                    android:textColor="#6B7A93"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvLastCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="最近检查：--"
                    android:textColor="#6B7A93"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ① 冻结屏幕 -->
            <Button
                android:id="@+id/btnFreeze"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="14dp"
                android:background="#2F6FED"
                android:text="@string/btn_freeze"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="@string/btn_freeze_sub"
                android:textColor="#8896AC"
                android:textSize="12sp" />

            <!-- ② 申请后端 -->
            <Button
                android:id="@+id/btnBackend"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="#12A150"
                android:text="@string/btn_backend"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="@string/btn_backend_sub"
                android:textColor="#8896AC"
                android:textSize="12sp" />

            <!-- 快捷动作 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="快捷动作"
                android:textColor="#16233A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCloseCurrent"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="#EEF2FA"
                    android:text="关闭当前App"
                    android:textColor="#2F6FED"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnHome"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="#EEF2FA"
                    android:text="返回桌面"
                    android:textColor="#2F6FED"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUnfreeze"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="#EEF2FA"
                    android:text="解除冻结"
                    android:textColor="#2F6FED"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnCheckNow"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="#EEF2FA"
                    android:text="立即检查页面"
                    android:textColor="#2F6FED"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 后端配置 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="后端（ADB）配置"
                android:textColor="#16233A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etHost"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:background="#FFFFFF"
                    android:hint="电脑IP，如 192.168.1.7"
                    android:inputType="textUri"
                    android:padding="10dp"
                    android:textColor="#16233A"
                    android:textColorHint="#A9B4C6"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:hint="端口"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textColor="#16233A"
                    android:textColorHint="#A9B4C6"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDiscover"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="#EEF2FA"
                    android:text="自动发现"
                    android:textColor="#2F6FED"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPing"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#EEF2FA"
                    android:text="测试连接"
                    android:textColor="#2F6FED"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSaveBackend"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#EEF2FA"
                    android:text="保存"
                    android:textColor="#2F6FED"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 日志 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="运行日志"
                android:textColor="#16233A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:fontFamily="monospace"
                android:minHeight="120dp"
                android:padding="12dp"
                android:text="（暂无）"
                android:textColor="#4A5A75"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
